#!/bin/sh
### BEGIN INIT INFO
# Provides:          emping
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: emping ICMP echo monitor
# Description:       Passive ICMP echo request/reply monitor
### END INIT INFO

DAEMON=/usr/local/bin/emping

case "$1" in
    start)
        "$DAEMON" start
        ;;
    stop)
        "$DAEMON" stop
        ;;
    restart)
        "$DAEMON" stop
        "$DAEMON" start
        ;;
    status)
        "$DAEMON" status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 3
        ;;
esac
